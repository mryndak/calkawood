# CalkaWood — zmienne środowiskowe
# Skopiuj ten plik do .env i uzupełnij właściwymi wartościami
# NIE COMMITUJ pliku .env do repozytorium!

# ─── Baza danych (PostgreSQL 16+) ───────────────────────────────────────────
# Format: postgresql://użytkownik:hasło@host:port/nazwa_bazy
DATABASE_URL=postgresql://user:password@localhost:5432/calkawood

# ─── Resend (email transakcyjny) ────────────────────────────────────────────
# Klucz API z panelu Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adres nadawcy dla powiadomień o nowych wycenach
RESEND_FROM_EMAIL=wycena@calkawood.pl

# ─── Panel administracyjny ──────────────────────────────────────────────────
# Hasło dostępu do panelu admina (/admin)
ADMIN_PASSWORD=zmien-to-haslo-na-silne

# ─── Upload plików ──────────────────────────────────────────────────────────
# Ścieżka do katalogu uploadów (poza repozytorium!)
# Na MyDevil np. /home/user/uploads
UPLOAD_DIR=/absolute/path/to/uploads

# ─── Analityka (Umami/Plausible) ────────────────────────────────────────────
# URL skryptu analitycznego. Jeśli puste — skrypt nie będzie ładowany.
# Przykład Umami: https://analytics.calkawood.pl/script.js
# Przykład Plausible: https://plausible.io/js/script.js
PUBLIC_ANALYTICS_URL=
# ID strony w panelu Umami (opcjonalne dla Plausible)
PUBLIC_ANALYTICS_SITE_ID=
