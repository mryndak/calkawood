# CalkaWood — zmienne środowiskowe
# Skopiuj ten plik do .env i uzupełnij właściwymi wartościami
# NIE COMMITUJ pliku .env do repozytorium!

# ─── Baza danych (PostgreSQL 16+) ───────────────────────────────────────────
# Format: postgresql://użytkownik:hasło@host:port/nazwa_bazy
# Ta sama zmienna jest używana przez aplikację ORAZ przez node-pg-migrate
# (npm run migrate:up / migrate:down) — patrz katalog migrations/.
DATABASE_URL=postgresql://user:password@localhost:5432/calkawood

# ─── Resend (email transakcyjny) ────────────────────────────────────────────
# Klucz API z panelu Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Adres nadawcy dla powiadomień o nowych wycenach
RESEND_FROM_EMAIL=wycena@calkawood.pl

# Adres odbiorcy powiadomień o nowych wycenach/wiadomościach kontaktowych
NOTIFICATION_EMAIL=kontakt@calkawood.pl

# ─── Panel administracyjny ──────────────────────────────────────────────────
# Hasło dostępu do panelu admina (/admin)
ADMIN_PASSWORD=zmien-to-haslo-na-silne

# ─── Upload plików ──────────────────────────────────────────────────────────
# Ścieżka do katalogu uploadów (poza repozytorium!)
# Na MyDevil np. /home/user/uploads
UPLOAD_DIR=/absolute/path/to/uploads

# ─── Analityka (Umami/Plausible) ────────────────────────────────────────────
# URL skryptu analitycznego. Jeśli puste — skrypt nie będzie ładowany.
# Przykład Umami: https://analytics.calkawood.pl/script.js
# Przykład Plausible: https://plausible.io/js/script.js
PUBLIC_ANALYTICS_URL=
# ID strony w panelu Umami (opcjonalne dla Plausible)
PUBLIC_ANALYTICS_SITE_ID=

# ─── Google Analytics (GA4) ─────────────────────────────────────────────────
# Jeśli puste — skrypt GA w ogóle się nie ładuje (patrz BaseLayout.astro).
# ID pomiaru z panelu GA4, np. G-XXXXXXXXXX
# UWAGA: GA korzysta z cookies. Polityka prywatności (/polityka-prywatnosci)
# obecnie deklaruje brak cookies analitycznych — przed ustawieniem tego ID
# trzeba zaktualizować politykę i dodać baner zgody na cookies (RODO).
PUBLIC_GA_MEASUREMENT_ID=

# ─── Google reCAPTCHA v2 (formularz kontaktowy i wycena) ────────────────────
# Klucze wygenerujesz na https://www.google.com/recaptcha/admin dla domeny
# calkawood.pl (typ: reCAPTCHA v2 — "Nie jestem robotem").
# Bez tych kluczy formularze działają jak dotąd (tylko honeypot + limit żądań) —
# captcha nie blokuje wysyłki, dopóki obie wartości nie są ustawione.
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
