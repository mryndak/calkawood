---
import { getImage } from 'astro:assets';
import '@/styles/global.css';
import SEOHead from '@/components/ui/SEOHead.astro';
import CookieConsentBanner from '@/components/ui/CookieConsentBanner.astro';
import defaultOgSource from '@/assets/photos/zadaszenie-taras-meble.jpeg';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object;
  noindex?: boolean;
}

const {
  title,
  description = 'Stolarka na wymiar, tarasy, budowa szkieletowa — Podkarpacie. Solidnie od 5 lat.',
  canonical,
  ogImage,
  structuredData,
  noindex = false,
} = Astro.props;

// Kanoniczny URL domyślnie to bieżąca ścieżka bez query stringa (np.
// /realizacje?kategoria=domy kanonizuje się do /realizacje), chyba że
// strona jawnie poda inny.
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Domyślne zdjęcie do Open Graph/Twitter Card, gdy strona nie poda własnego —
// bez tego udostępnienie linku (Facebook, Messenger, WhatsApp) nie pokazuje
// żadnej miniatury.
const defaultOgImage = await getImage({ src: defaultOgSource, width: 1200, height: 630, format: 'jpg' });
const resolvedOgImage = ogImage ?? new URL(defaultOgImage.src, Astro.site).href;

const analyticsUrl = import.meta.env.PUBLIC_ANALYTICS_URL;

// Google Analytics — nieaktywne, dopóki PUBLIC_GA_MEASUREMENT_ID jest puste
// (patrz .env.example). Consent Mode startuje z domyślną odmową, żeby GA nie
// zapisywał cookies, zanim strona nie doda baneru zgody i nie zaktualizuje
// polityki prywatności.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'pl'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogImage={resolvedOgImage}
      structuredData={structuredData}
      noindex={noindex}
    />
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} is:inline></script>
        <script define:vars={{ gaMeasurementId }} is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('consent', 'default', { analytics_storage: 'denied' });
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
    <CookieConsentBanner />
    {analyticsUrl && (
      <script
        defer
        data-website-id={import.meta.env.PUBLIC_ANALYTICS_SITE_ID ?? ''}
        src={analyticsUrl}
        is:inline
      />
    )}
  </body>
</html>
