---
import { getImage } from 'astro:assets';
import '@/styles/global.css';
import SEOHead from '@/components/ui/SEOHead.astro';
import defaultOgSource from '@/assets/photos/zadaszenie-taras-meble.jpeg';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object;
  noindex?: boolean;
}

const {
  title,
  description = 'Stolarka na wymiar, tarasy, budowa szkieletowa — Podkarpacie. Solidnie od 5 lat.',
  canonical,
  ogImage,
  structuredData,
  noindex = false,
} = Astro.props;

// Kanoniczny URL domyślnie to bieżąca ścieżka bez query stringa (np.
// /realizacje?kategoria=domy kanonizuje się do /realizacje), chyba że
// strona jawnie poda inny.
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// Domyślne zdjęcie do Open Graph/Twitter Card, gdy strona nie poda własnego —
// bez tego udostępnienie linku (Facebook, Messenger, WhatsApp) nie pokazuje
// żadnej miniatury.
const defaultOgImage = await getImage({ src: defaultOgSource, width: 1200, height: 630, format: 'jpg' });
const resolvedOgImage = ogImage ?? new URL(defaultOgImage.src, Astro.site).href;

const analyticsUrl = import.meta.env.PUBLIC_ANALYTICS_URL;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Lora:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <SEOHead
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogImage={resolvedOgImage}
      structuredData={structuredData}
      noindex={noindex}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <slot />
    {analyticsUrl && (
      <script
        defer
        data-website-id={import.meta.env.PUBLIC_ANALYTICS_SITE_ID ?? ''}
        src={analyticsUrl}
        is:inline
      />
    )}
  </body>
</html>
