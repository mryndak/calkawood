---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/ui/Navigation.astro';
import Footer from '@/components/ui/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, structuredData, noindex } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  structuredData={structuredData}
  noindex={noindex}
>
  <Navigation />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
