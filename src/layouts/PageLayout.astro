---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/ui/Navigation.astro';
import Footer from '@/components/ui/Footer.astro';
import { buildBreadcrumbList, withBreadcrumbs, type BreadcrumbItem } from '@/lib/breadcrumbs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object;
  noindex?: boolean;
  // Strona sama renderuje widoczne okruszki (komponent Breadcrumbs) tam, gdzie
  // pasują do jej layoutu — ten prop tylko dokleja odpowiadający im
  // BreadcrumbList do structuredData, żeby nie duplikować listy w dwóch miejscach.
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, canonical, ogImage, structuredData, noindex, breadcrumbs } = Astro.props;

const finalStructuredData = breadcrumbs
  ? withBreadcrumbs(structuredData, buildBreadcrumbList(breadcrumbs, Astro.site!))
  : structuredData;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  structuredData={finalStructuredData}
  noindex={noindex}
>
  <Navigation />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
