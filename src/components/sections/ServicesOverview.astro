---
import { Image } from 'astro:assets';
import tarasyImg from '@/assets/photos/taras-przy-domu.jpeg';
import zadaszeniaImg from '@/assets/photos/pergola-taras-slup.jpeg';
import wnetrzaImg from '@/assets/photos/schody-wnetrze.jpeg';
import domyImg from '@/assets/photos/dom-szkieletowy-elewacja.jpeg';
import saunyImg from '@/assets/photos/sauna-ogrodowa-zewnetrze.jpeg';
---

<section class="bg-background px-4 py-20 sm:px-6 lg:px-8 sm:py-28" aria-labelledby="services-heading">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-wrap items-end justify-between gap-10">
      <div class="max-w-[640px]">
        <p class="kicker">Co budujemy</p>
        <h2 id="services-heading" class="mt-[18px] text-3xl leading-[1.02] tracking-[-0.025em] text-text sm:text-5xl lg:text-[60px]">
          Dom to nasza pierwsza odpowiedź
        </h2>
      </div>
      <p class="max-w-[44ch] text-base leading-[1.7] text-text-secondary">
        Reszta oferty rośnie wokół domu: sauna w ogrodzie, taras przy wyjściu z salonu, zadaszenie nad
        wejściem, wykończenie wnętrza. Można zamówić jedną rzecz albo wszystko po kolei.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-[1.35fr_1fr]">
      <!-- Domy drewniane — karta główna -->
      <a
        href="/uslugi/domy"
        class="group flex flex-col border border-hairline transition-colors hover:border-primary"
      >
        <div class="plate aspect-[16/10] w-full sm:aspect-auto sm:h-[400px]">
          <Image
            src={domyImg}
            alt="Dom szkieletowy z drewnianą elewacją"
            class="h-full w-full object-cover"
            width={700}
            height={440}
          />
        </div>
        <div class="p-6 sm:p-8">
          <div class="flex flex-wrap items-baseline gap-3.5">
            <span class="font-serif text-3xl tracking-[-0.02em] text-text">Domy drewniane</span>
            <span class="border border-accent-border bg-accent-soft px-2.5 py-1 text-[11px] tracking-[0.14em] text-primary-dark uppercase">
              Główna usługa
            </span>
          </div>
          <p class="mt-3 max-w-[52ch] text-base leading-[1.7] text-text-secondary">
            Szkieletowe i z bali, energooszczędne, w stanie surowym zamkniętym lub pod klucz. Prowadzimy
            formalności, konstrukcję, dach, elewację i wnętrze.
          </p>
          <div class="mt-5 flex flex-wrap gap-7 text-[13px] tabular-nums text-text-muted">
            <span>Od 3 400 zł / m²</span>
            <span>Budowa 4–7 miesięcy</span>
            <span class="text-primary-dark">Dowiedz się więcej →</span>
          </div>
        </div>
      </a>

      <!-- Sauny + Tarasy — kolumna kart poziomych -->
      <div class="flex flex-col gap-6">
        <a
          href="/uslugi/sauny"
          class="group flex border border-hairline transition-colors hover:border-primary"
        >
          <div class="plate aspect-square w-32 shrink-0 sm:w-40">
            <Image
              src={saunyImg}
              alt="Kabina sauny ogrodowej z antracytową zabudową"
              class="h-full w-full object-cover"
              width={320}
              height={320}
            />
          </div>
          <div class="p-5">
            <h3 class="font-serif text-xl text-text sm:text-2xl">Sauny</h3>
            <p class="mt-1.5 text-sm text-text-secondary">Ogrodowe i wnętrzowe — fińska, beczkowa, na wymiar.</p>
          </div>
        </a>
        <a
          href="/uslugi/tarasy"
          class="group flex border border-hairline transition-colors hover:border-primary"
        >
          <div class="plate w-32 shrink-0 sm:w-40">
            <Image
              src={tarasyImg}
              alt="Taras drewniany przy domu"
              class="h-full w-full object-cover"
              width={320}
              height={320}
            />
          </div>
          <div class="p-5">
            <h3 class="font-serif text-xl text-text sm:text-2xl">Tarasy</h3>
            <p class="mt-1.5 text-sm text-text-secondary">Drewniane, kompozytowe, betonowe i kamienne.</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Altany i zadaszenia + Podłogi i wnętrza -->
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
      <a
        href="/uslugi/zadaszenia"
        class="group flex border border-hairline transition-colors hover:border-primary"
      >
        <div class="plate w-32 shrink-0 sm:w-40">
          <Image
            src={zadaszeniaImg}
            alt="Pergola nad tarasem wsparta na słupie"
            class="h-full w-full object-cover"
            width={320}
            height={320}
          />
        </div>
        <div class="p-5">
          <h3 class="font-serif text-xl text-text sm:text-2xl">Altany i zadaszenia</h3>
          <p class="mt-1.5 text-sm text-text-secondary">Altany, pergole, wiaty i zadaszenia na wymiar.</p>
        </div>
      </a>
      <a
        href="/uslugi/wnetrza"
        class="group flex border border-hairline transition-colors hover:border-primary"
      >
        <div class="plate w-32 shrink-0 sm:w-40">
          <Image
            src={wnetrzaImg}
            alt="Drewniane schody wewnętrzne"
            class="h-full w-full object-cover"
            width={320}
            height={320}
          />
        </div>
        <div class="p-5">
          <h3 class="font-serif text-xl text-text sm:text-2xl">Podłogi i wnętrza</h3>
          <p class="mt-1.5 text-sm text-text-secondary">Układanie paneli, podłóg drewnianych, remonty wnętrz.</p>
        </div>
      </a>
    </div>
  </div>
</section>
