---
import { getCollection } from 'astro:content';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';

const allProjects = await getCollection('projects');

// Featured first, then sort by date descending, limit to 3 (jak w makiecie)
const projects = allProjects
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  })
  .slice(0, 3);

function metaLine(project: (typeof projects)[number]): string {
  const year = new Date(project.data.date).getFullYear();
  const parts = [project.data.location];
  if (project.data.area) parts.push(`${project.data.area} m²`);
  parts.push(String(year));
  return parts.join(' · ');
}
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-10 sm:py-[110px]" aria-labelledby="portfolio-heading">
  <div class="flex flex-wrap items-end justify-between gap-6 border-b border-hairline pb-12">
    <div>
      <p class="kicker">Realizacje</p>
      <h2 id="portfolio-heading" class="mt-[18px] text-3xl leading-[1.02] tracking-[-0.025em] text-text sm:text-5xl">
        Zdjęcia z naszych budów
      </h2>
    </div>
    <a
      href="/realizacje"
      class="inline-flex items-center rounded-[4px] border border-primary px-6 py-3 font-serif text-base text-primary-dark transition-colors hover:bg-accent-soft"
    >
      Wszystkie realizacje →
    </a>
  </div>

  <div class="mt-[26px] grid grid-cols-1 gap-[26px] sm:grid-cols-3">
    {projects.map((project) => (
      <a href={`/realizacje?kategoria=${project.data.category}`} class="block">
        {project.data.images[0] ? (
          <div class="plate">
            <img
              src={project.data.images[0].src}
              alt={project.data.images[0].alt}
              loading="lazy"
              decoding="async"
              width="400"
              height="300"
              class="h-[300px] w-full object-cover"
            />
          </div>
        ) : (
          <PhotoPlaceholder
            description={project.data.placeholderNote ?? project.data.title}
            ratio="aspect-auto h-[300px]"
          />
        )}
        <div class="pt-4">
          <p class="kicker">{metaLine(project)}</p>
          <p class="mt-2 font-serif text-2xl leading-[1.2] text-text">{project.data.title}</p>
        </div>
      </a>
    ))}
  </div>
</section>
