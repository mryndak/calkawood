---
import { Image } from 'astro:assets';
import { Phone } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import heroImage from '@/assets/photos/zadaszenie-taras-meble.jpeg';
---

<section
  class="relative flex min-h-[420px] items-end overflow-hidden bg-dark sm:min-h-[calc(100vh-96px)]"
  aria-label="Sekcja powitalna"
>
  <Image
    src={heroImage}
    alt="Zadaszony taras z drewna z meblami ogrodowymi"
    class="absolute inset-0 h-full w-full object-cover opacity-[0.66] sepia-[0.2] saturate-[0.85]"
    width={1920}
    height={1280}
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(23,21,15,0.55), rgba(23,21,15,0.15) 40%, rgba(23,21,15,0.9));"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-10 sm:px-10 sm:pb-[72px]">
    <div class="hero-content max-w-[900px] pt-12 sm:pt-0">
      <p class="kicker kicker-on-dark mb-4 hidden sm:mb-[22px] sm:block">Wojciech Całka i zespół · Podkarpacie od 2021</p>

      <h1 class="text-[34px] leading-[0.98] tracking-[-0.025em] text-[#f7f5f1] sm:text-6xl lg:text-[88px]">
        Domy drewniane,<br />
        sauny i tarasy<br />
        <span class="text-dark-accent">z jednej ręki</span>
      </h1>

      <p class="mt-4 max-w-[56ch] text-base leading-[1.65] text-[#cfc9bd] sm:mt-[26px] sm:text-lg lg:text-[19px]">
        Prowadzimy budowę od pierwszego pomiaru do odbioru: konstrukcja szkieletowa, sauna ogrodowa,
        zadaszenie, taras. Bez podwykonawców.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3.5 sm:mt-10">
        <Button href="tel:+48661084830" variant="on-dark" size="lg" aria-label="Zadzwoń do CalkaWood">
          <Phone class="h-4 w-4" stroke-width={1.6} aria-hidden="true" />
          661 084 830
        </Button>
        <Button href="/wycena" variant="on-dark-outline" size="lg" aria-label="Przejdź do wyceny online">
          Wycena online →
        </Button>
        <span class="text-sm text-dark-text-secondary">Odpowiadamy w 24 h, także w sobotę</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-content {
    animation: hero-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content {
      animation: none;
    }
  }
</style>
