---
import Button from '@/components/ui/Button.astro';
---

<section
  class="relative flex min-h-[70vh] items-center justify-center overflow-hidden bg-dark"
  aria-label="Sekcja powitalna"
>
  <!-- TODO: Zamienić na background-image z realizacji, np.:
       style={`background-image: url('/images/hero.webp')`}
       + dodać <Image /> z astro:assets dla optymalizacji -->

  <div class="relative z-10 mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <svg viewBox="0 0 120 120" class="mx-auto h-16 w-16 sm:h-20 sm:w-20" role="img" aria-label="Znak CalkaWood">
      <mask id="hero-logo-mask">
        <rect width="120" height="120" fill="#fff"></rect>
        <polygon points="55,63 132,31 132,95" fill="#000"></polygon>
      </mask>
      <g mask="url(#hero-logo-mask)">
        <g fill="none" stroke="#c9c3b6" stroke-linecap="round">
          <circle cx="55" cy="63" r="5" stroke-width="1.1"></circle>
          <circle cx="55.4" cy="62.7" r="9.5" stroke-width="0.9"></circle>
          <circle cx="55.8" cy="62.4" r="13.5" stroke-width="1.3"></circle>
          <circle cx="56.2" cy="62.1" r="17" stroke-width="0.9"></circle>
          <circle cx="56.6" cy="61.8" r="21.5" stroke-width="1"></circle>
          <circle cx="57" cy="61.5" r="25" stroke-width="1.4"></circle>
          <circle cx="57.4" cy="61.2" r="29.5" stroke-width="0.9"></circle>
          <circle cx="57.8" cy="60.9" r="33" stroke-width="1"></circle>
          <circle cx="58.2" cy="60.6" r="37.5" stroke-width="1.3"></circle>
          <circle cx="58.6" cy="60.3" r="41" stroke-width="0.9"></circle>
          <circle cx="59" cy="60" r="45.5" stroke-width="1"></circle>
          <circle cx="59.4" cy="59.7" r="49" stroke-width="1.2"></circle>
        </g>
        <circle cx="60" cy="60" r="53.5" fill="none" stroke="#c99a4f" stroke-width="2.4"></circle>
      </g>
    </svg>

    <h1 class="mt-6 text-3xl font-bold leading-tight text-dark-text sm:text-4xl lg:text-5xl">
      Stolarka na wymiar. Solidnie od 5 lat.
    </h1>

    <p class="mx-auto mt-4 max-w-xl text-lg text-dark-text-secondary sm:text-xl">
      Altany, tarasy, podłogi — rzemiosło z pasją na Podkarpaciu
    </p>

    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <Button href="tel:+48123456789" variant="cta" size="lg" aria-label="Zadzwoń do CalkaWood">
        📞 Zadzwoń
      </Button>
      <Button href="/wycena" variant="primary" size="lg" aria-label="Przejdź do wyceny online">
        Wyceń online
      </Button>
    </div>
  </div>
</section>
