---
/**
 * Sekcja kontaktowa — telefon CTA, mini formularz kontaktowy, dane firmy.
 * Formularz na razie jest wizualnym placeholderem (brak obsługi JS/backend).
 */
---

<section class="px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="contact-heading" class="text-center text-2xl font-bold text-text sm:text-3xl">
      Kontakt
    </h2>

    <p class="mx-auto mt-3 max-w-xl text-center text-sm text-text/70 sm:text-base">
      Masz pytanie lub chcesz omówić projekt? Zadzwoń lub napisz — odpowiemy w ciągu 24 godzin.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <!-- Formularz kontaktowy -->
      <div>
        <h3 class="text-lg font-semibold text-text">Napisz do nas</h3>

        <form
          class="mt-4 space-y-4"
          action="#"
          method="POST"
          aria-label="Formularz kontaktowy"
        >
          <div>
            <label for="contact-name" class="block text-sm font-medium text-text">
              Imię <span class="text-cta" aria-label="pole wymagane">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="imie"
              required
              autocomplete="given-name"
              class="mt-1 block w-full rounded-md border border-gray-300 bg-background px-3 py-2 text-sm text-text placeholder-text/40 shadow-sm transition-colors focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              placeholder="Jan"
            />
          </div>

          <div>
            <label for="contact-phone" class="block text-sm font-medium text-text">
              Telefon <span class="text-cta" aria-label="pole wymagane">*</span>
            </label>
            <input
              type="tel"
              id="contact-phone"
              name="telefon"
              required
              autocomplete="tel"
              class="mt-1 block w-full rounded-md border border-gray-300 bg-background px-3 py-2 text-sm text-text placeholder-text/40 shadow-sm transition-colors focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              placeholder="+48 123 456 789"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-sm font-medium text-text">
              Wiadomość <span class="text-cta" aria-label="pole wymagane">*</span>
            </label>
            <textarea
              id="contact-message"
              name="wiadomosc"
              required
              rows="4"
              class="mt-1 block w-full resize-y rounded-md border border-gray-300 bg-background px-3 py-2 text-sm text-text placeholder-text/40 shadow-sm transition-colors focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent"
              placeholder="Opisz krótko, w czym możemy pomóc..."
            ></textarea>
          </div>

          <!-- Honeypot — ukryte pole, boty je wypełnią -->
          <div class="hidden" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-lg bg-ink px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink-hover focus:outline-none focus:ring-2 focus:ring-cta/50 focus:ring-offset-2 sm:w-auto"
          >
            Wyślij wiadomość
          </button>
        </form>
      </div>

      <!-- Dane kontaktowe i CTA telefon -->
      <div class="flex flex-col justify-between">
        <div>
          <h3 class="text-lg font-semibold text-text">Dane firmy</h3>

          <dl class="mt-4 space-y-4 text-sm text-text/80">
            <div>
              <dt class="font-medium text-text">Firma</dt>
              <dd>CalkaWood — Wojciech Całka</dd>
            </div>
            <div>
              <dt class="font-medium text-text">Region</dt>
              <dd>Województwo podkarpackie — Rzeszów, Krosno i okolice</dd>
            </div>
            <div>
              <dt class="font-medium text-text">Usługi</dt>
              <dd>Stolarka na wymiar, tarasy, podłogi, budowa szkieletowa</dd>
            </div>
          </dl>
        </div>

        <!-- CTA Telefon — duży, wyraźny przycisk -->
        <div class="mt-8 rounded-xl border border-accent/20 bg-accent/5 p-6 text-center">
          <p class="text-sm font-medium text-text/70">Najszybszy kontakt:</p>

          <a
            href="tel:+48123456789"
            class="mt-3 inline-flex items-center gap-3 text-2xl font-bold text-primary-dark transition-colors hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent/50 focus:ring-offset-2 sm:text-3xl"
            aria-label="Zadzwoń pod numer +48 123 456 789"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent text-xl text-white" aria-hidden="true">
              📞
            </span>
            +48 123 456 789
          </a>

          <p class="mt-2 text-xs text-text/50">
            Pon–Pt: 7:00–18:00 | Sob: 8:00–14:00
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
