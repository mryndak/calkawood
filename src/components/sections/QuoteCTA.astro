---
import Button from '@/components/ui/Button.astro';
---

<section class="bg-dark py-14 sm:py-16" aria-labelledby="quote-cta-heading">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <h2 id="quote-cta-heading" class="text-2xl font-bold text-dark-text sm:text-3xl">
      Wycena online w 3 prostych krokach
    </h2>

    <p class="mx-auto mt-4 max-w-xl text-lg text-dark-text-secondary">
      Wybierz usługę, opisz projekt, dodaj zdjęcia — odpowiemy w 24 godziny.
    </p>

    <div class="mt-8">
      <Button href="/wycena" variant="outline" size="lg">
        Wyceń swój projekt
      </Button>
    </div>
  </div>
</section>
