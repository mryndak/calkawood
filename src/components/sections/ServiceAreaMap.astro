---
/**
 * Sekcja mapy obszaru działania — interaktywna mapa OpenStreetMap (Leaflet)
 * z jednym wspólnym konturem obszaru działania, będącym sumą granic
 * 4 obsługiwanych województw: małopolskiego, podkarpackiego,
 * świętokrzyskiego i lubelskiego (bez wewnętrznych granic między nimi —
 * patrz src/data/serviceAreaBoundaries.ts).
 * Układ (kicker/h2/akapit/siatka województw po lewej, mapa po prawej) 1:1 z
 * handoffem — tylko statyczne SVG z makiety zastąpione działającą mapą Leaflet.
 */
import {
  SERVICE_AREA_OUTLINE,
  SERVICE_AREA_COLOR,
} from '@/data/serviceAreaBoundaries';

interface Props {
  heading?: string;
  intro?: string;
}

const {
  heading = 'Cztery województwa, jeden zespół',
  intro = 'Budujemy w promieniu około 180 km od Rzeszowa. Przy większych zleceniach — domy, sauny — dojeżdżamy dalej; wystarczy zapytać.',
} = Astro.props;

const coveredVoivodeships = [
  { key: 'malopolskie', name: 'małopolskie', examples: 'Kraków, Tarnów, Nowy Sącz' },
  { key: 'podkarpackie', name: 'podkarpackie', examples: 'Rzeszów, Krosno, Tarnobrzeg' },
  { key: 'swietokrzyskie', name: 'świętokrzyskie', examples: 'Kielce, Sandomierz, Ostrowiec Świętokrzyski' },
  { key: 'lubelskie', name: 'lubelskie', examples: 'Lublin, Zamość, Puławy' },
];

const mapDataJson = JSON.stringify({
  outline: SERVICE_AREA_OUTLINE,
  color: SERVICE_AREA_COLOR,
});
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-10 sm:py-[110px]" aria-labelledby="service-area-heading">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center lg:gap-[70px]">
    <!-- Tekst + lista województw -->
    <div>
      <p class="kicker">Obszar działania</p>
      <h2 id="service-area-heading" class="mt-[18px] text-3xl leading-[1.03] tracking-[-0.025em] text-text sm:text-5xl">
        {heading}
      </h2>
      <p class="mt-6 max-w-[50ch] text-base leading-[1.75] text-text-secondary">
        {intro}
      </p>

      <div class="mt-[34px] grid grid-cols-1 border-t border-hairline sm:grid-cols-2">
        {coveredVoivodeships.map((v) => (
          <div class="border-b border-hairline py-5 pr-5">
            <p class="font-serif text-xl text-text capitalize">{v.name}</p>
            <p class="mt-1 text-[12.5px] text-text-muted">{v.examples}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Mapa OpenStreetMap (Leaflet) -->
    <div class="rounded-[4px] border border-hairline bg-surface p-[30px]">
      <div
        class="service-area-leaflet isolate aspect-[5/4] w-full overflow-hidden rounded-[4px]"
        data-map={mapDataJson}
        role="img"
        aria-label="Mapa obszaru działania CalkaWood obejmująca województwa małopolskie, podkarpackie, świętokrzyskie i lubelskie"
      >
      </div>
    </div>
  </div>
</section>

<style>
  .service-area-leaflet :global(.leaflet-container) {
    height: 100%;
    width: 100%;
    font-family: inherit;
    background: #f4f1ea;
  }
</style>

<script>
  import L from 'leaflet';
  // `?url` zamiast zwykłego importu CSS: Astro/Vite wciąż hashuje i cache'uje
  // plik, ale nie wstrzykuje go jako blokujący <link> w <head> SSR — mapa jest
  // poniżej pierwszego ekranu, więc jej CSS ładujemy dopiero tutaj, gdy skrypt
  // faktycznie startuje (patrz PageSpeed: było to źródło ~180ms render-blocking).
  import leafletCssHref from 'leaflet/dist/leaflet.css?url';

  type MapData = {
    outline: [number, number][];
    color: string;
  };

  const POLAND_BOUNDS = L.latLngBounds([48.95, 14.1], [54.9, 24.2]);

  const containers = document.querySelectorAll<HTMLElement>('.service-area-leaflet[data-map]');

  if (containers.length > 0 && !document.querySelector(`link[href="${leafletCssHref}"]`)) {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = leafletCssHref;
    document.head.appendChild(link);
  }

  containers.forEach((el) => {
    const data = JSON.parse(el.dataset.map ?? '{}') as MapData;

    const map = L.map(el, {
      scrollWheelZoom: false,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // Jeden wspólny kontur całego obszaru działania (suma 4 województw) —
    // bez rozróżniania poszczególnych regionów, żeby nie sugerować, że
    // któryś z nich jest "główny", a pozostałe drugorzędne.
    L.polygon(data.outline, {
      color: data.color,
      weight: 1.5,
      opacity: 1,
      fillColor: data.color,
      fillOpacity: 0.08,
    }).addTo(map);

    map.fitBounds(POLAND_BOUNDS, { padding: [4, 4] });

    new ResizeObserver(() => map.invalidateSize()).observe(el);
  });
</script>
