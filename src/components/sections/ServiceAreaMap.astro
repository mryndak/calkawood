---
/**
 * Sekcja mapy obszaru działania — interaktywna mapa OpenStreetMap (Leaflet)
 * z rzeczywistymi granicami administracyjnymi 4 obsługiwanych województw:
 * małopolskiego, podkarpackiego, świętokrzyskiego i lubelskiego.
 */
import { CAPITALS, VOIVODESHIP_BOUNDARIES, VOIVODESHIP_COLORS } from '@/data/serviceAreaBoundaries';

const coveredVoivodeships = [
  { key: 'malopolskie', name: 'małopolskie', examples: 'Kraków, Tarnów, Nowy Sącz' },
  { key: 'podkarpackie', name: 'podkarpackie', examples: 'Rzeszów, Krosno, Tarnobrzeg' },
  { key: 'swietokrzyskie', name: 'świętokrzyskie', examples: 'Kielce, Sandomierz, Ostrowiec Świętokrzyski' },
  { key: 'lubelskie', name: 'lubelskie', examples: 'Lublin, Zamość, Puławy' },
];

const mapDataJson = JSON.stringify({
  boundaries: VOIVODESHIP_BOUNDARIES,
  colors: VOIVODESHIP_COLORS,
  capitals: CAPITALS,
});
---

<section class="bg-background px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="service-area-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="service-area-heading" class="text-center text-2xl font-bold text-text sm:text-3xl">
      Obszar działania
    </h2>

    <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-text/70 sm:text-base">
      Działamy na terenie czterech województw: małopolskiego, podkarpackiego, świętokrzyskiego i lubelskiego.
    </p>

    <div class="mt-10 flex flex-col items-center gap-8 lg:flex-row lg:items-start lg:gap-12">
      <!-- Mapa OpenStreetMap -->
      <div class="w-full max-w-md flex-shrink-0 lg:w-1/2">
        <div
          class="service-area-leaflet aspect-[5/4] w-full overflow-hidden rounded-xl border border-text/10 bg-text/5"
          data-map={mapDataJson}
          role="img"
          aria-label="Mapa obszaru działania CalkaWood obejmująca województwa małopolskie, podkarpackie, świętokrzyskie i lubelskie"
        >
        </div>

        <p class="mt-2 text-center text-xs text-text/50">
          Mapa © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="underline">OpenStreetMap</a> contributors, style © <a href="https://carto.com/attributions" target="_blank" rel="noopener noreferrer" class="underline">CARTO</a> — przybliż lub przesuń, aby zobaczyć szczegóły.
        </p>
      </div>

      <!-- Lista województw -->
      <div class="w-full lg:w-1/2">
        <h3 class="text-lg font-semibold text-text">
          Obsługiwane województwa
        </h3>
        <p class="mt-1 text-sm text-text/70">
          Realizujemy zlecenia na terenie poniższych województw:
        </p>

        <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2" role="list">
          {coveredVoivodeships.map((v) => (
            <li class="flex items-start gap-2 text-sm text-text">
              <span
                class="mt-1 inline-block h-3 w-3 flex-shrink-0 rounded-full"
                style={`background-color:${VOIVODESHIP_COLORS[v.key]}`}
                aria-hidden="true"
              ></span>
              <span>
                <span class="font-medium">Województwo {v.name}</span>
                <span class="block text-text/60">{v.examples}</span>
              </span>
            </li>
          ))}
        </ul>

        <p class="mt-6 text-sm text-text/60">
          Nie widzisz swojego regionu? Zadzwoń — w wielu przypadkach dojedziemy dalej.
        </p>

        <a
          href="tel:+48123456789"
          class="mt-4 inline-flex items-center gap-2 rounded-lg bg-ink px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink-hover focus:outline-none focus:ring-2 focus:ring-cta/50 focus:ring-offset-2"
          aria-label="Zadzwoń do CalkaWood, aby zapytać o obsługę Twojego regionu"
        >
          📞 Zadzwoń i zapytaj
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .service-area-leaflet :global(.leaflet-container) {
    height: 100%;
    width: 100%;
    font-family: inherit;
    background: #f4f1ea;
  }

  .service-area-leaflet :global(.service-area-label) {
    border: none;
    background: transparent;
    box-shadow: none;
    font-weight: 600;
    font-size: 11px;
    color: #7d5411;
    text-shadow:
      -1px -1px 0 #fff,
      1px -1px 0 #fff,
      -1px 1px 0 #fff,
      1px 1px 0 #fff;
    white-space: nowrap;
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type CapitalPoint = { voivodeship: string; city: string; lat: number; lng: number };
  type MapData = {
    boundaries: Record<string, [number, number][]>;
    colors: Record<string, string>;
    capitals: CapitalPoint[];
  };

  const CAPITAL_MARKER_COLOR = '#7d5411';

  const POLAND_BOUNDS = L.latLngBounds([48.95, 14.1], [54.9, 24.2]);

  const containers = document.querySelectorAll<HTMLElement>('.service-area-leaflet[data-map]');

  containers.forEach((el) => {
    const data = JSON.parse(el.dataset.map ?? '{}') as MapData;

    const map = L.map(el, {
      scrollWheelZoom: false,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    for (const [key, latlngs] of Object.entries(data.boundaries)) {
      const color = data.colors[key] ?? '#4A7C59';
      L.polygon(latlngs, {
        color,
        weight: 2.5,
        fillColor: color,
        fillOpacity: 0.3,
      }).addTo(map);
    }

    for (const capital of data.capitals) {
      L.circleMarker([capital.lat, capital.lng], {
        radius: 6,
        color: '#ffffff',
        weight: 2,
        fillColor: CAPITAL_MARKER_COLOR,
        fillOpacity: 0.95,
      })
        .addTo(map)
        .bindTooltip(capital.voivodeship, {
          permanent: true,
          direction: 'top',
          className: 'service-area-label',
          offset: [0, -6],
        });
    }

    map.fitBounds(POLAND_BOUNDS, { padding: [4, 4] });

    new ResizeObserver(() => map.invalidateSize()).observe(el);
  });
</script>
