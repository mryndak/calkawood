---
interface Props {
  href?: string;
  variant: 'primary' | 'cta' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href, variant, size = 'md', class: className } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center font-semibold rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2';

// Warianty zaprojektowane pod ciemne sekcje „wizytówkowe" (hero, banery CTA) —
// jedyne miejsca, gdzie ten komponent jest dziś używany. Złoty akcent pojawia
// się tylko jako obwódka/podkreślenie, nigdy jako duże wypełnienie.
const variantClasses: Record<typeof variant, string> = {
  cta: 'border-b-2 border-primary bg-background text-text hover:bg-surface focus-visible:ring-primary',
  primary:
    'border-2 border-dark-accent bg-transparent text-dark-text hover:bg-dark-accent/10 focus-visible:ring-dark-accent',
  outline:
    'border-2 border-dark-text/50 text-dark-text hover:bg-dark-text hover:text-dark focus-visible:ring-dark-text',
};

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-5 py-2.5 text-base',
  lg: 'px-7 py-3.5 text-lg',
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes}>
      <slot />
    </button>
  )
}
