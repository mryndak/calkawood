---
interface Props {
  href?: string;
  variant: 'dark' | 'gold-outline' | 'neutral-outline' | 'on-dark' | 'on-dark-outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href, variant, size = 'md', class: className } = Astro.props;

const baseClasses =
  'inline-flex items-center justify-center gap-2 rounded-[4px] font-serif font-normal transition-colors';

// Warianty wg handoffu: kolor jako obwódka, nie wypełnienie. Jedyne dopuszczalne
// duże wypełnienia to przycisk `dark` (na jasnym tle) i `on-dark` (na ciemnym tle).
const variantClasses: Record<typeof variant, string> = {
  dark: 'border border-transparent bg-ink text-background hover:bg-ink-hover',
  'gold-outline': 'border border-primary bg-transparent text-primary-dark hover:bg-accent-soft',
  'neutral-outline': 'border border-text/22 bg-transparent text-text hover:bg-text/7',
  'on-dark': 'border border-transparent bg-background text-ink hover:bg-white',
  'on-dark-outline': 'border border-dark-text/45 bg-transparent text-dark-text hover:border-dark-accent hover:text-dark-accent',
};

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3.5 text-base',
  lg: 'px-[30px] py-5 text-lg',
};

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes}>
      <slot />
    </button>
  )
}
