---
import translations from '@/i18n/pl.json';

const currentYear = new Date().getFullYear();
const phoneNumber = '+48123456789';
const phoneFormatted = '+48 123 456 789';

const quickLinks = [
  { label: translations.nav.services, href: '/uslugi/stolarka-na-wymiar' },
  { label: translations.nav.portfolio, href: '/realizacje' },
  { label: translations.nav.quote, href: '/wycena' },
  { label: translations.nav.contact, href: '/kontakt' },
];

const legalLinks = [
  { label: 'Polityka prywatności', href: '/polityka-prywatnosci' },
  { label: 'Regulamin', href: '/regulamin' },
];
---

<footer class="bg-dark text-dark-text" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- Firma: znak (SVG) + wordmark/podpis jako prawdziwy tekst -->
      <div>
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 120 120" class="h-12 w-12 sm:h-14 sm:w-14" role="img" aria-hidden="true">
            <mask id="footer-logo-mask">
              <rect width="120" height="120" fill="#fff"></rect>
              <polygon points="55,63 132,31 132,95" fill="#000"></polygon>
            </mask>
            <g mask="url(#footer-logo-mask)">
              <g fill="none" stroke="#c9c3b6" stroke-linecap="round">
                <circle cx="55" cy="63" r="5" stroke-width="1.1"></circle>
                <circle cx="55.4" cy="62.7" r="9.5" stroke-width="0.9"></circle>
                <circle cx="55.8" cy="62.4" r="13.5" stroke-width="1.3"></circle>
                <circle cx="56.2" cy="62.1" r="17" stroke-width="0.9"></circle>
                <circle cx="56.6" cy="61.8" r="21.5" stroke-width="1"></circle>
                <circle cx="57" cy="61.5" r="25" stroke-width="1.4"></circle>
                <circle cx="57.4" cy="61.2" r="29.5" stroke-width="0.9"></circle>
                <circle cx="57.8" cy="60.9" r="33" stroke-width="1"></circle>
                <circle cx="58.2" cy="60.6" r="37.5" stroke-width="1.3"></circle>
                <circle cx="58.6" cy="60.3" r="41" stroke-width="0.9"></circle>
                <circle cx="59" cy="60" r="45.5" stroke-width="1"></circle>
                <circle cx="59.4" cy="59.7" r="49" stroke-width="1.2"></circle>
              </g>
              <circle cx="60" cy="60" r="53.5" fill="none" stroke="#c99a4f" stroke-width="2.4"></circle>
            </g>
          </svg>
          <div>
            <p class="font-serif text-2xl tracking-[0.08em] text-dark-text sm:text-3xl">
              CAŁKA<span class="text-dark-accent">WOOD</span>
            </p>
            <p class="mt-1 border-t border-dark-accent/40 pt-1 font-tagline text-[11px] tracking-[0.3em] text-dark-text-secondary">
              DOMY SAUNY ZADASZENIA TARASY
            </p>
          </div>
        </div>
        <p class="mt-3 text-sm text-dark-text-secondary">{translations.site.tagline}</p>
      </div>

      <!-- Szybkie linki -->
      <nav aria-label="Linki pomocnicze">
        <p class="text-sm font-semibold uppercase tracking-wider text-dark-text-secondary">Nawigacja</p>
        <ul class="mt-3 space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-dark-text-secondary transition-colors hover:text-dark-text"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Kontakt i linki prawne -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-dark-text-secondary">Kontakt</p>
        <a
          href={`tel:${phoneNumber}`}
          class="mt-3 inline-flex items-center gap-2 text-lg font-semibold text-dark-text transition-colors hover:text-dark-accent"
          aria-label={`Zadzwoń: ${phoneFormatted}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z"
              clip-rule="evenodd"
            />
          </svg>
          {phoneFormatted}
        </a>

        <ul class="mt-4 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-dark-text-secondary transition-colors hover:text-dark-text"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 border-t border-dark-text/20 pt-6 text-center text-sm text-dark-text-secondary">
      <p>&copy; {currentYear} {translations.site.name}. Wszelkie prawa zastrzeżone.</p>
    </div>
  </div>
</footer>
