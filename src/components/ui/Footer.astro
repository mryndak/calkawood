---
import { Phone } from '@lucide/astro';
import translations from '@/i18n';

const currentYear = new Date().getFullYear();
const phoneNumber = '+48123456789';
const phoneFormatted = '+48 123 456 789';

// Osobnych podstron usług nie ma — cała oferta jest opisana na stronie głównej
// (sekcja „Oferta”), więc linki prowadzą do przefiltrowanej galerii realizacji.
const offerLinks = [
  { label: translations.services.domy, href: '/realizacje?kategoria=domy' },
  { label: translations.services.sauny, href: '/realizacje?kategoria=sauny' },
  { label: translations.services.tarasy, href: '/realizacje?kategoria=tarasy' },
  { label: translations.services.zadaszenia, href: '/realizacje?kategoria=zadaszenia' },
  { label: translations.services.wnetrza, href: '/realizacje?kategoria=wnetrza' },
];

const companyLinks = [
  { label: translations.nav.about, href: '/o-mnie' },
  { label: translations.nav.portfolio, href: '/realizacje' },
  { label: translations.nav.quote, href: '/wycena' },
  { label: translations.nav.contact, href: '/kontakt' },
];

const legalLinks = [
  { label: 'Polityka prywatności', href: '/polityka-prywatnosci' },
  { label: 'Regulamin', href: '/regulamin' },
];

// TODO: podmienić na docelowe adresy profili, gdy będą gotowe.
const socialLinks = [
  { label: 'Facebook', href: '#' },
  { label: 'Instagram', href: '#' },
];
---

<footer class="bg-dark text-dark-text" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 sm:py-20">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Logo poziome + opis + telefon -->
      <div>
        <img
          src="/logo/logotyp-poziomy-ciemne-tlo.svg"
          alt={translations.site.name}
          class="h-auto w-[220px] max-w-full sm:w-[270px]"
          width="270"
          height="64"
        />
        <p class="mt-4 text-sm text-dark-text-secondary">{translations.site.tagline}</p>
        <a
          href={`tel:${phoneNumber}`}
          class="mt-4 inline-flex items-center gap-2 font-serif text-[22px] font-normal text-dark-text transition-colors hover:text-dark-accent"
          aria-label={`Zadzwoń: ${phoneFormatted}`}
        >
          <Phone class="h-5 w-5" stroke-width={1.6} aria-hidden="true" />
          {phoneFormatted}
        </a>

        <ul class="mt-5 flex items-center gap-4">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-hairline-dark text-dark-text-secondary transition-colors hover:border-dark-accent hover:text-dark-accent"
              >
                {link.label === 'Facebook' ? (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                  </svg>
                ) : (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Oferta -->
      <nav aria-label="Oferta">
        <p class="kicker kicker-on-dark">Oferta</p>
        <ul class="mt-4 space-y-2.5">
          {offerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-dark-text-secondary transition-colors hover:text-dark-text"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Firma -->
      <nav aria-label="Firma">
        <p class="kicker kicker-on-dark">Firma</p>
        <ul class="mt-4 space-y-2.5">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-dark-text-secondary transition-colors hover:text-dark-text"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Godziny -->
      <div>
        <p class="kicker kicker-on-dark">Godziny</p>
        <dl class="mt-4 space-y-2.5 text-sm text-dark-text-secondary">
          <div class="flex justify-between gap-4">
            <dt>Pon–Pt</dt>
            <dd class="tabular-nums">7:00–18:00</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt>Sobota</dt>
            <dd class="tabular-nums">8:00–14:00</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Pasek dolny -->
    <div class="mt-14 flex flex-col items-center gap-4 border-t border-hairline-dark pt-6 text-sm text-dark-text-secondary sm:flex-row sm:justify-between">
      <p>&copy; {currentYear} {translations.site.name}. Wszelkie prawa zastrzeżone.</p>
      <ul class="flex items-center gap-6">
        {legalLinks.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-dark-text">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
