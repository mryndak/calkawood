---
import translations from '@/i18n/pl.json';

const currentYear = new Date().getFullYear();
const phoneNumber = '+48123456789';
const phoneFormatted = '+48 123 456 789';

const quickLinks = [
  { label: translations.nav.services, href: '/uslugi/stolarka-na-wymiar' },
  { label: translations.nav.portfolio, href: '/realizacje' },
  { label: translations.nav.quote, href: '/wycena' },
  { label: translations.nav.contact, href: '/kontakt' },
];

const legalLinks = [
  { label: 'Polityka prywatności', href: '/polityka-prywatnosci' },
  { label: 'Regulamin', href: '/regulamin' },
];
---

<footer class="bg-primary-dark text-white" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- Firma -->
      <div>
        <p class="text-xl font-bold text-white">{translations.site.name}</p>
        <p class="mt-2 text-sm text-white/80">{translations.site.tagline}</p>
      </div>

      <!-- Szybkie linki -->
      <nav aria-label="Linki pomocnicze">
        <p class="text-sm font-semibold uppercase tracking-wider text-white/60">Nawigacja</p>
        <ul class="mt-3 space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/80 transition-colors hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Kontakt i linki prawne -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-white/60">Kontakt</p>
        <a
          href={`tel:${phoneNumber}`}
          class="mt-3 inline-flex items-center gap-2 text-lg font-semibold text-white transition-colors hover:text-primary"
          aria-label={`Zadzwoń: ${phoneFormatted}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z"
              clip-rule="evenodd"
            />
          </svg>
          {phoneFormatted}
        </a>

        <ul class="mt-4 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-white/80 transition-colors hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 border-t border-white/20 pt-6 text-center text-sm text-white/60">
      <p>&copy; {currentYear} {translations.site.name}. Wszelkie prawa zastrzeżone.</p>
    </div>
  </div>
</footer>
