---
import { Phone } from '@lucide/astro';
import t from '@/i18n/pl.json';
import Button from '@/components/ui/Button.astro';
import MobileMenu from '@/components/islands/MobileMenu.tsx';

const PHONE_NUMBER = '+48 123 456 789';
const PHONE_HREF = 'tel:+48123456789';

const navLinks = [
  { label: t.nav.home, href: '/' },
  { label: t.nav.portfolio, href: '/realizacje' },
  { label: t.nav.quote, href: '/wycena' },
  { label: t.nav.about, href: '/o-mnie' },
  { label: t.nav.contact, href: '/kontakt' },
];
---

<!-- Skip to content link — first focusable element for keyboard users -->
<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-cta focus:ring-offset-2"
>
  Przeskocz do treści
</a>

<header class="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-sm border-b border-primary/10 shadow-sm">
  <nav aria-label="Nawigacja główna" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-24 items-center justify-between">
      <!-- Logo: znak (SVG) + wordmark jako prawdziwy tekst (fonty ładują się niezależnie od SVG) -->
      <a
        href="/"
        class="flex flex-shrink-0 items-center gap-3 transition-opacity hover:opacity-80"
      >
        <img
          src="/logo/znak-kolor.svg"
          alt=""
          aria-hidden="true"
          class="h-11 w-11"
          width="44"
          height="44"
        />
        <span class="leading-tight">
          <span class="block font-serif text-[23px] tracking-[0.16em] text-text">
            CAŁKA<span class="text-primary-dark">WOOD</span>
          </span>
          <span class="mt-0.5 hidden font-tagline text-[10px] tracking-[0.3em] text-text-muted sm:block">
            DOMY SAUNY ZADASZENIA TARASY
          </span>
        </span>
      </a>

      <!-- Desktop navigation (>=1024px) -->
      <ul class="hidden lg:flex items-center gap-1" role="menubar">
        {navLinks.map((link) => (
          <li role="none">
            <a
              href={link.href}
              role="menuitem"
              class="inline-flex items-center px-3 py-2 text-sm font-medium text-text hover:text-primary-dark rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Right side: Phone CTA + Wycena online + Mobile hamburger -->
      <div class="flex items-center gap-3">
        <!-- Phone CTA (desktop) -->
        <a
          href={PHONE_HREF}
          class="hidden items-center gap-2 rounded-[4px] border border-text/22 px-4 py-2.5 font-serif text-[15px] text-text transition-colors hover:border-primary hover:text-primary-dark lg:inline-flex"
          aria-label={`${t.cta.call}: ${PHONE_NUMBER}`}
        >
          <Phone class="h-3.5 w-3.5" stroke-width={1.8} aria-hidden="true" />
          <span class="tabular-nums">{PHONE_NUMBER}</span>
        </a>

        <!-- Wycena online (desktop) -->
        <div class="hidden lg:inline-flex">
          <Button href="/wycena" variant="dark" size="sm">
            Wycena online
          </Button>
        </div>

        <!-- Hamburger button (mobile/tablet, <1024px) -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center rounded-md p-2 text-text hover:bg-primary/10 hover:text-primary-dark lg:hidden transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Otwórz menu nawigacji"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu (React island) -->
  <MobileMenu client:idle links={navLinks} phone={PHONE_NUMBER} />
</header>

<!-- Spacer to compensate for fixed header height -->
<div class="h-24" aria-hidden="true"></div>
