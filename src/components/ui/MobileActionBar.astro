---
// Przyklejony pasek akcji na mobile — widoczny na wszystkich podstronach.
// Wymóg z handoffu: jedna decyzja dostępna zawsze w zasięgu kciuka.
const PHONE_HREF = 'tel:+48123456789';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1.4fr_1fr] border-t border-hairline bg-background/94 backdrop-blur-sm md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={PHONE_HREF}
    class="flex h-12 items-center justify-center gap-2 bg-ink text-sm font-serif font-normal text-background"
    aria-label="Zadzwoń teraz do CalkaWood"
  >
    Zadzwoń teraz
  </a>
  <a
    href="/wycena"
    class="flex h-12 items-center justify-center border-l border-hairline text-sm font-serif font-normal text-text"
    aria-label="Przejdź do wyceny online"
  >
    Wyceń
  </a>
</div>
<div class="h-12 md:hidden" aria-hidden="true"></div>
