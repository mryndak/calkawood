---
// Zastępuje brakujące zdjęcia realizacji (dom, sauna, portret) tak, żeby ich
// brak nie psuł layoutu. Usunąć, gdy firma dostarczy prawdziwy kadr.
import { Image as ImageIcon } from '@lucide/astro';

interface Props {
  description: string;
  class?: string;
  ratio?: string;
}

const { description, class: className, ratio = 'aspect-[4/3]' } = Astro.props;
---

<div
  class:list={[
    'flex flex-col items-center justify-center gap-2 border border-hairline bg-[#e2ded6] px-6 py-8 text-center',
    ratio,
    className,
  ]}
  role="img"
  aria-label={`Kadr do uzupełnienia: ${description}`}
>
  <ImageIcon class="h-7 w-7 text-text-muted" stroke-width={1.4} aria-hidden="true" />
  <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">Kadr do uzupełnienia</p>
  <p class="max-w-[22ch] text-xs text-text-muted">{description}</p>
</div>
