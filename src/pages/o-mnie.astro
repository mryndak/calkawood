---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import { Phone } from '@lucide/astro';

const title = 'O mnie — Wojciech Całka';
const description = 'Wojciech Całka — stolarz i budowniczy z Podkarpacia. Ponad 5 lat doświadczenia w stolarce na wymiar, tarasach i budowie szkieletowej.';
---

<PageLayout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-10 sm:py-[84px]">
    <p class="kicker">O mnie</p>
    <h1 class="mt-[18px] text-4xl leading-[1.01] tracking-[-0.025em] text-text sm:text-6xl">
      Wojciech Całka
    </h1>

    <p class="mt-6 max-w-[65ch] text-lg leading-[1.75] text-text-secondary">
      Nazywam się <strong class="font-semibold text-text">Wojciech Całka</strong> i prowadzę firmę{' '}
      <strong class="font-semibold text-text">CalkaWood</strong> — jednoosobową działalność
      stolarsko-budowlaną na Podkarpaciu. Od ponad 5 lat realizuję projekty z drewna i nie tylko,
      łącząc rzemiosło z nowoczesnym podejściem do materiałów i technologii.
    </p>

    <h2 class="mt-16 text-2xl leading-[1.1] text-text sm:text-4xl">Doświadczenie zawodowe</h2>

    <p class="mt-4 max-w-[65ch] text-base leading-[1.75] text-text-secondary">
      Przez lata zdobywałem doświadczenie pracując przy różnorodnych projektach — od
      niewielkich elementów stolarki na wymiar, przez tarasy i podłogi, aż po budowę
      domów w technologii szkieletowej. Każde zlecenie traktuję indywidualnie, dobierając
      materiały i rozwiązania do potrzeb klienta.
    </p>

    <ul class="mt-6 space-y-3 border-t border-hairline pt-6 text-base leading-[1.6] text-text-secondary">
      <li class="flex items-start gap-3">
        <span class="mt-2.5 inline-block h-1 w-1 flex-shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
        <span><strong class="font-semibold text-text">Stolarka na wymiar</strong> — altany, pergole, wiaty, zadaszenia, drzwi, blaty, antresole</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-2.5 inline-block h-1 w-1 flex-shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
        <span><strong class="font-semibold text-text">Tarasy</strong> — drewniane, kompozytowe, betonowe, kamienne</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-2.5 inline-block h-1 w-1 flex-shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
        <span><strong class="font-semibold text-text">Podłogi i wnętrza</strong> — montaż paneli, renowacja podłóg, remonty</span>
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-2.5 inline-block h-1 w-1 flex-shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
        <span><strong class="font-semibold text-text">Budowa szkieletowa</strong> — domy i budynki gospodarcze w technologii kanadyjskiej</span>
      </li>
    </ul>

    <h2 class="mt-16 text-2xl leading-[1.1] text-text sm:text-4xl">Wartości, którymi się kieruję</h2>

    <div class="mt-6 grid grid-cols-1 gap-8 border-t border-hairline pt-8 sm:grid-cols-3 sm:gap-10">
      <div>
        <p class="font-serif text-xl text-text">Sumienność</p>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">
          Każdy projekt realizuję terminowo i z pełnym zaangażowaniem. Traktuję zlecenia
          klientów tak, jakbym budował dla siebie.
        </p>
      </div>

      <div>
        <p class="font-serif text-xl text-text">Rzetelność</p>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">
          Jasna komunikacja, uczciwa wycena i dotrzymywanie ustaleń. Nie obiecuję tego,
          czego nie jestem w stanie wykonać.
        </p>
      </div>

      <div>
        <p class="font-serif text-xl text-text">Dbałość o detale</p>
        <p class="mt-2 text-sm leading-relaxed text-text-secondary">
          Wykończenie ma znaczenie. Dbam o precyzję, estetykę i trwałość każdego elementu
          — od fundamentu po ostatnie szlify.
        </p>
      </div>
    </div>

    <h2 class="mt-16 text-2xl leading-[1.1] text-text sm:text-4xl">Region działania</h2>

    <p class="mt-4 max-w-[65ch] text-base leading-[1.75] text-text-secondary">
      Działam na terenie województwa podkarpackiego — Rzeszów, Krosno i okoliczne powiaty
      (brzozowski, dębicki, jasielski, łańcucki, ropczycko-sędziszowski, rzeszowski,
      strzyżowski). W przypadku większych projektów dojadę dalej — wystarczy zadzwonić
      i ustalić szczegóły.
    </p>

    <div class="mt-14 border-t border-hairline pt-10 text-center">
      <p class="text-base text-text-secondary">Masz projekt do omówienia?</p>
      <div class="mt-4 inline-flex">
        <Button href="tel:+48123456789" variant="dark" size="lg" aria-label="Zadzwoń pod numer +48 123 456 789">
          <Phone class="h-4 w-4" stroke-width={1.6} aria-hidden="true" />
          +48 123 456 789
        </Button>
      </div>
    </div>
  </section>
</PageLayout>
