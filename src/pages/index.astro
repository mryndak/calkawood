---
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import StatsBar from '@/components/sections/StatsBar.astro';
import ServicesOverview from '@/components/sections/ServicesOverview.astro';
import CraftSection from '@/components/sections/CraftSection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import PortfolioSlider from '@/components/sections/PortfolioSlider.astro';
import QuoteCTA from '@/components/sections/QuoteCTA.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import ServiceAreaMap from '@/components/sections/ServiceAreaMap.astro';

import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import schemaImageSource from '@/assets/photos/taras-dom-nowoczesny.jpeg';
import t from '@/i18n';

const schemaImage = await getImage({ src: schemaImageSource, width: 1200, format: 'jpg' });
const schemaImageUrl = new URL(schemaImage.src, Astro.site).href;

const testimonials = await getCollection('testimonials');
const ratingCount = testimonials.length;
const averageRating = ratingCount
  ? testimonials.reduce((sum, t) => sum + t.data.rating, 0) / ratingCount
  : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "CalkaWood",
  "description": "Usługi stolarsko-budowlane na Podkarpaciu: domy drewniane, altany, sauny, tarasy, zadaszenia i wnętrza.",
  "telephone": "+48661084830",
  "image": schemaImageUrl,
  "areaServed": [
    { "@type": "State", "name": "małopolskie" },
    { "@type": "State", "name": "podkarpackie" },
    { "@type": "State", "name": "świętokrzyskie" },
    { "@type": "State", "name": "lubelskie" }
  ],
  "serviceType": [
    "Domy drewniane",
    "Sauny",
    "Tarasy",
    "Altany, zadaszenia i pergole",
    "Podłogi i wnętrza"
  ],
  "url": "https://calkawood.pl",
  ...(averageRating && {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": averageRating.toFixed(1),
      "reviewCount": ratingCount
    }
  })
};
---

<PageLayout
  title={t.meta.home.title}
  description={t.meta.home.description}
  structuredData={structuredData}
>
  <Hero />
  <StatsBar />
  <ServicesOverview />
  <CraftSection />
  <ProcessSection />
  <PortfolioSlider />
  <Testimonials />
  <ServiceAreaMap />
  <QuoteCTA />
</PageLayout>
