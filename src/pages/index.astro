---
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import StatsBar from '@/components/sections/StatsBar.astro';
import ServicesOverview from '@/components/sections/ServicesOverview.astro';
import CraftSection from '@/components/sections/CraftSection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import PortfolioSlider from '@/components/sections/PortfolioSlider.astro';
import QuoteCTA from '@/components/sections/QuoteCTA.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import ServiceAreaMap from '@/components/sections/ServiceAreaMap.astro';

import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import schemaImageSource from '@/assets/photos/taras-dom-nowoczesny.jpeg';
import t from '@/i18n';

const schemaImage = await getImage({ src: schemaImageSource, width: 1200, format: 'jpg' });
const schemaImageUrl = new URL(schemaImage.src, Astro.site).href;

const testimonials = await getCollection('testimonials');
const ratingCount = testimonials.length;
const averageRating = ratingCount
  ? testimonials.reduce((sum, t) => sum + t.data.rating, 0) / ratingCount
  : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "CalkaWood",
  "legalName": "MLC GROUP Wojciech Całka",
  "description": "Usługi stolarsko-budowlane na Podkarpaciu: domy drewniane, altany, sauny, tarasy, zadaszenia i wnętrza.",
  "telephone": "+48661084830",
  "image": schemaImageUrl,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Niechobrz 792d",
    "postalCode": "36-047",
    "addressLocality": "Niechobrz",
    "addressRegion": "podkarpackie",
    "addressCountry": "PL"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 49.9985822,
    "longitude": 21.8624775
  },
  "hasMap": "https://www.google.com/maps/place/Ca%C5%82kaWood+-+MLC+GROUP+Wojciech+Ca%C5%82ka/@49.9985822,21.8599026,979m/data=!3m1!1e3!4m9!1m2!2m1!1sWojciech+Ca%C5%82ka+Niechobrz+792d!3m5!1s0x473cff45ccb504f7:0xd83af82fbd87be29!8m2!3d49.9985822!4d21.8624775!16s%2Fg%2F11nvs38zq6",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "07:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday"],
      "opens": "08:00",
      "closes": "14:00"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/profile.php?id=61593752109796",
    "https://fixly.pl/profil/6gvbnlii",
    "https://www.google.com/maps/place/Ca%C5%82kaWood+-+MLC+GROUP+Wojciech+Ca%C5%82ka/@49.9985822,21.8599026,979m/data=!3m1!1e3!4m9!1m2!2m1!1sWojciech+Ca%C5%82ka+Niechobrz+792d!3m5!1s0x473cff45ccb504f7:0xd83af82fbd87be29!8m2!3d49.9985822!4d21.8624775!16s%2Fg%2F11nvs38zq6"
  ],
  "areaServed": [
    { "@type": "State", "name": "małopolskie" },
    { "@type": "State", "name": "podkarpackie" },
    { "@type": "State", "name": "świętokrzyskie" },
    { "@type": "State", "name": "lubelskie" }
  ],
  "serviceType": [
    "Domy drewniane",
    "Sauny",
    "Tarasy",
    "Altany, zadaszenia i pergole",
    "Podłogi i wnętrza"
  ],
  "url": "https://calkawood.pl",
  ...(averageRating && {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": averageRating.toFixed(1),
      "reviewCount": ratingCount
    }
  })
};
---

<PageLayout
  title={t.meta.home.title}
  description={t.meta.home.description}
  structuredData={structuredData}
>
  <Hero />
  <StatsBar />
  <ServicesOverview />
  <CraftSection />
  <ProcessSection />
  <PortfolioSlider />
  <Testimonials />
  <ServiceAreaMap />
  <QuoteCTA />
</PageLayout>
