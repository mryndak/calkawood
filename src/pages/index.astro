---
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import StatsBar from '@/components/sections/StatsBar.astro';
import ServicesOverview from '@/components/sections/ServicesOverview.astro';
import CraftSection from '@/components/sections/CraftSection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import PortfolioSlider from '@/components/sections/PortfolioSlider.astro';
import QuoteCTA from '@/components/sections/QuoteCTA.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import ServiceAreaMap from '@/components/sections/ServiceAreaMap.astro';

import { getCollection } from 'astro:content';

const testimonials = await getCollection('testimonials');
const ratingCount = testimonials.length;
const averageRating = ratingCount
  ? testimonials.reduce((sum, t) => sum + t.data.rating, 0) / ratingCount
  : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "CalkaWood",
  "description": "Usługi stolarsko-budowlane na Podkarpaciu: domy drewniane, sauny, tarasy, zadaszenia i wnętrza.",
  "telephone": "+48123456789",
  "image": "https://calkawood.pl/images/projects/taras-dom-nowoczesny.jpeg",
  "areaServed": [
    { "@type": "State", "name": "małopolskie" },
    { "@type": "State", "name": "podkarpackie" },
    { "@type": "State", "name": "świętokrzyskie" },
    { "@type": "State", "name": "lubelskie" }
  ],
  "serviceType": [
    "Domy drewniane",
    "Sauny",
    "Tarasy",
    "Zadaszenia i pergole",
    "Podłogi i wnętrza"
  ],
  "url": "https://calkawood.pl",
  ...(averageRating && {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": averageRating.toFixed(1),
      "reviewCount": ratingCount
    }
  })
};
---

<PageLayout
  title="Domy drewniane, tarasy i sauny — Podkarpacie"
  description="Stolarka na wymiar, tarasy, podłogi i budowa szkieletowa. Ponad 5 lat doświadczenia na Podkarpaciu. Bezpłatna wycena online."
  structuredData={structuredData}
>
  <Hero />
  <StatsBar />
  <ServicesOverview />
  <CraftSection />
  <ProcessSection />
  <PortfolioSlider />
  <Testimonials />
  <ServiceAreaMap />
  <QuoteCTA />
</PageLayout>
