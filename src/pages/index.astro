---
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import StatsBar from '@/components/sections/StatsBar.astro';
import ServicesOverview from '@/components/sections/ServicesOverview.astro';
import CraftSection from '@/components/sections/CraftSection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import PortfolioSlider from '@/components/sections/PortfolioSlider.astro';
import QuoteCTA from '@/components/sections/QuoteCTA.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import ServiceAreaMap from '@/components/sections/ServiceAreaMap.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "CalkaWood",
  "description": "Usługi stolarsko-budowlane na Podkarpaciu",
  "telephone": "+48123456789",
  "areaServed": {
    "@type": "State",
    "name": "podkarpackie"
  },
  "serviceType": [
    "Domy drewniane",
    "Sauny",
    "Tarasy",
    "Zadaszenia i pergole",
    "Podłogi i wnętrza"
  ],
  "url": "https://calkawood.pl"
};
---

<PageLayout
  title="Strona główna"
  description="CalkaWood — stolarka na wymiar, tarasy, podłogi, budowa szkieletowa. Solidne usługi stolarsko-budowlane na Podkarpaciu."
  structuredData={structuredData}
>
  <Hero />
  <StatsBar />
  <ServicesOverview />
  <CraftSection />
  <ProcessSection />
  <PortfolioSlider />
  <Testimonials />
  <ServiceAreaMap />
  <QuoteCTA />
</PageLayout>
