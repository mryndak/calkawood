---
import PageLayout from '@/layouts/PageLayout.astro';
import QuoteCTA from '@/components/sections/QuoteCTA.astro';
import { SERVICE_PAGES, SERVICE_CATEGORY_ORDER } from '@/data/servicePages';
import t from '@/i18n';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Usługi', item: new URL('/uslugi', Astro.site).href },
  ],
};
---

<PageLayout title={t.meta.services.title} description={t.meta.services.description} structuredData={structuredData}>
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-10 sm:pt-[84px]">
    <nav aria-label="Okruszki" class="mb-6 flex flex-wrap items-center gap-1.5 text-[13px] text-text-muted">
      <a href="/" class="hover:text-primary-dark hover:underline">Strona główna</a>
      <span aria-hidden="true">/</span>
      <span class="text-text">Usługi</span>
    </nav>

    <div class="grid grid-cols-1 gap-8 border-b border-hairline pb-11 sm:grid-cols-2 sm:items-end sm:gap-[70px]">
      <div>
        <p class="kicker">Oferta</p>
        <h1 class="mt-[18px] text-4xl leading-none tracking-[-0.025em] text-text sm:text-6xl lg:text-[64px]">
          Co budujemy
        </h1>
      </div>
      <p class="max-w-[52ch] text-base leading-[1.75] text-text-secondary">
        Pięć usług, jedna ekipa: domy, sauny, tarasy, zadaszenia i wykończenia wnętrz. Wybierz kategorię, żeby
        zobaczyć szczegóły, przykładowe realizacje i najczęstsze pytania.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 pb-20 sm:grid-cols-2 sm:pb-28">
      {SERVICE_CATEGORY_ORDER.map((category) => {
        const content = SERVICE_PAGES[category];
        return (
          <a
            href={`/uslugi/${category}`}
            class="group flex flex-col justify-between border border-hairline p-6 transition-colors hover:border-primary sm:p-8"
          >
            <div>
              <p class="kicker">{content.kicker}</p>
              <p class="mt-3 font-serif text-2xl text-text sm:text-[26px]">{content.h1}</p>
              <p class="mt-3 text-sm leading-relaxed text-text-secondary">{content.intro}</p>
            </div>
            <p class="mt-6 text-sm text-primary-dark">
              Zobacz szczegóły →
            </p>
          </a>
        );
      })}
    </div>
  </section>

  <QuoteCTA />
</PageLayout>
