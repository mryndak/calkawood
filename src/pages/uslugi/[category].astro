---
// Bez prerender: reszta serwisu jest w pełni SSR, a strony statyczne
// (dist/client/uslugi/x/index.html) dostają dodatkowe przekierowanie 301
// na wersję ze slashem na końcu od serwera plików — SSR unika tej niespójności.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import PhotoPlaceholder from '@/components/ui/PhotoPlaceholder.astro';
import Button from '@/components/ui/Button.astro';
import QuoteCTA from '@/components/sections/QuoteCTA.astro';
import { SERVICE_PAGES, type ServiceCategory } from '@/data/servicePages';
import t from '@/i18n';
import { getQuoteCalculatorEnabled } from '@/lib/db';

const quoteEnabled = await getQuoteCalculatorEnabled();


const requestedCategory = Astro.params.category;
if (!requestedCategory || !(requestedCategory in SERVICE_PAGES)) {
  return Astro.redirect('/uslugi', 302);
}
const category = requestedCategory as ServiceCategory;

const content = SERVICE_PAGES[category];
const meta = t.meta[category];

// Zdjęcia i placeholdery pochodzą z kolekcji realizacji (src/content/projects.json),
// żeby strona usługi pokazywała wszystko, co jest w galerii danej kategorii.
const categoryProjects = (await getCollection('projects'))
  .filter((project) => project.data.category === category)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const photos = categoryProjects.flatMap((project) => project.data.images);
const placeholderDescriptions = categoryProjects.flatMap((project) =>
  project.data.placeholderNote ? [project.data.placeholderNote] : []
);

const breadcrumbs = [
  { name: t.breadcrumbs.home, href: '/' },
  { name: t.breadcrumbs.services, href: '/uslugi' },
  { name: content.kicker, href: Astro.url.pathname },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: content.h1,
      description: meta.description,
      provider: {
        '@type': 'HomeAndConstructionBusiness',
        name: 'CalkaWood',
        telephone: '+48661084830',
      },
      areaServed: [
        { '@type': 'State', name: 'małopolskie' },
        { '@type': 'State', name: 'podkarpackie' },
        { '@type': 'State', name: 'świętokrzyskie' },
        { '@type': 'State', name: 'lubelskie' },
      ],
      url: new URL(Astro.url.pathname, Astro.site).href,
    },
    ...(content.faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: content.faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: { '@type': 'Answer', text: item.answer },
            })),
          },
        ]
      : []),
  ],
};
---

<PageLayout
  title={meta.title}
  description={meta.description}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <!-- Nagłówek -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-10 sm:pt-[84px]">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 gap-8 border-b border-hairline pb-11 sm:grid-cols-2 sm:items-end sm:gap-[70px]">
      <div>
        <p class="kicker">{content.kicker}</p>
        <h1 class="mt-[18px] text-4xl leading-none tracking-[-0.025em] text-text sm:text-6xl lg:text-[64px]">
          {content.h1}
        </h1>
      </div>
      <p class="max-w-[52ch] text-base leading-[1.75] text-text-secondary">
        {content.intro}
      </p>
    </div>
  </section>

  <!-- Co obejmuje usługa -->
  <section class="bg-background px-4 py-20 sm:px-6 lg:px-8 sm:py-28" aria-labelledby="highlights-heading">
    <div class="mx-auto max-w-7xl">
      <h2 id="highlights-heading" class="text-3xl leading-[1.02] tracking-[-0.025em] text-text sm:text-4xl">
        Co obejmuje ta usługa
      </h2>
      <div class="mt-10 grid grid-cols-1 gap-8 border-t border-hairline pt-10 sm:grid-cols-2">
        {content.highlights.map((item) => (
          <div>
            <p class="font-serif text-xl text-text">{item.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Zdjęcia -->
  <section class="border-y border-hairline bg-surface" aria-labelledby="photos-heading">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-10 sm:py-[100px]">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="photos-heading" class="text-3xl leading-[1.02] tracking-[-0.025em] text-text sm:text-4xl">
          Realizacje
        </h2>
        <a
          href={`/realizacje?kategoria=${category}`}
          class="text-sm text-primary-dark underline decoration-1 underline-offset-[3px] hover:text-accent"
        >
          Zobacz wszystkie w galerii →
        </a>
      </div>

      {photos.length > 0 ? (
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {photos.map((photo) => (
            <a href={`/realizacje?kategoria=${category}`} class="plate block aspect-[4/3]">
              <Image src={photo.src} alt={photo.alt} class="h-full w-full object-cover" width={500} height={375} loading="lazy" />
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {placeholderDescriptions.map((description) => (
            <PhotoPlaceholder description={description} ratio="aspect-[4/3]" />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- FAQ -->
  {content.faq.length > 0 && (
    <section class="bg-background px-4 py-20 sm:px-6 lg:px-8 sm:py-28" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-7xl">
        <h2 id="faq-heading" class="text-3xl leading-[1.02] tracking-[-0.025em] text-text sm:text-4xl">
          Najczęstsze pytania
        </h2>
        <div class="mt-10 grid grid-cols-1 border-t border-hairline sm:max-w-[75ch]">
          {content.faq.map((item) => (
            <div class="border-b border-hairline py-6">
              <p class="font-serif text-lg text-text">{item.question}</p>
              <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-surface px-4 py-14 sm:px-6 lg:px-8" aria-label="Wezwanie do działania">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-6">
      <p class="max-w-[44ch] font-serif text-xl text-text sm:text-2xl">
        Masz podobny projekt na myśli?
      </p>
      <div class="flex flex-wrap gap-3">
        {quoteEnabled && <Button href="/wycena" variant="dark" size="lg">Wycena online →</Button>}
        <Button href={`/realizacje?kategoria=${category}`} variant="neutral-outline" size="lg">
          Zobacz realizacje
        </Button>
      </div>
    </div>
  </section>

  <QuoteCTA />
</PageLayout>
